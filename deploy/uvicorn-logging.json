{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "monsoongrid_json": {
      "()": "monsoon_grid.observability.JsonLogFormatter",
      "gcp_project_id": null,
      "service": "monsoongrid",
      "revision": "unknown"
    }
  },
  "handlers": {
    "stdout": {
      "class": "logging.StreamHandler",
      "formatter": "monsoongrid_json",
      "stream": "ext://sys.stdout"
    }
  },
  "loggers": {
    "uvicorn": {"handlers": ["stdout"], "level": "INFO", "propagate": false},
    "uvicorn.error": {"handlers": ["stdout"], "level": "INFO", "propagate": false},
    "uvicorn.access": {"handlers": ["stdout"], "level": "WARNING", "propagate": false}
  },
  "root": {"handlers": ["stdout"], "level": "INFO"}
}
